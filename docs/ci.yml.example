name: ci
on:
  pull_request:
  push:
    branches: [main]
concurrency:
  group: ci-${{ github.ref }}
  cancel-in-progress: true

jobs:
  check:
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - uses: actions/checkout@v4
        with: { fetch-depth: 0 }
      - uses: actions/setup-node@v4
        with: { node-version: 20, cache: npm }
      - name: Install
        run: if [ -f package-lock.json ]; then npm ci; else npm install; fi
      - run: npm run typecheck
      - run: npm run check:boundaries
      - run: npm run check:assets
      - run: npm test
      - run: npm run build
      - name: Owners touched (info)
        if: github.event_name == 'pull_request'
        run: node scripts/check-owners.mjs origin/${{ github.base_ref }}
      - uses: actions/upload-artifact@v4
        with: { name: dist, path: dist, retention-days: 3 }

  smoke:
    needs: check
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with: { node-version: 20, cache: npm }
      - run: if [ -f package-lock.json ]; then npm ci; else npm install; fi
      - run: npm i --no-save playwright@1.48.2 && npx playwright install --with-deps chromium
      - run: npm run build
      - run: npm run smoke
